<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Big Moe 3D Blocks</title>

<style>
*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#7db7e8;font-family:Arial,sans-serif;touch-action:none}
body{user-select:none}
canvas{display:block}
#hud{position:fixed;inset:0;pointer-events:none;color:white;text-shadow:2px 2px #222;z-index:10}
#crosshair{position:absolute;left:50%;top:50%;width:18px;height:18px;transform:translate(-50%,-50%)}
#touch{display:none;position:absolute;inset:0;pointer-events:none}
.joy{position:absolute;width:132px;height:132px;border-radius:50%;background:rgba(0,0,0,.28);border:3px solid rgba(255,255,255,.45);pointer-events:auto;touch-action:none}
#joystick{left:22px;bottom:28px}
#stick{position:absolute;width:56px;height:56px;left:35px;top:35px;border-radius:50%;background:rgba(255,255,255,.35);border:2px solid rgba(255,255,255,.7)}
.touchBtn{position:absolute;width:62px;height:62px;border-radius:50%;background:rgba(0,0,0,.4);border:3px solid rgba(255,255,255,.55);color:#fff;font-weight:bold;font-size:24px;pointer-events:auto;touch-action:none}
#jump{right:26px;bottom:36px}
#mine{right:100px;bottom:106px}
#place{right:26px;bottom:116px}
#sprint{right:26px;bottom:190px;font-size:14px}
#slotsTouch{position:absolute;left:50%;bottom:92px;transform:translateX(-50%);display:flex;gap:5px;pointer-events:auto}
#slotsTouch button{width:45px;height:45px;padding:0;background:rgba(0,0,0,.5);border:2px solid #777;color:#fff;font-size:12px}
#slotsTouch button.selected{border-color:#fff;box-shadow:0 0 0 2px #555 inset}
@media (pointer:coarse){#touch{display:block}#inventoryHint{display:none}#hotbar{display:none}#bars{bottom:145px;font-size:17px}#status{top:56%}#breakBar{top:59%}#top{font-size:11px;top:8px;left:8px}}
#crosshair:before,#crosshair:after{content:"";position:absolute;background:#fff;box-shadow:1px 1px #222}
#crosshair:before{width:2px;height:18px;left:8px;top:0}
#crosshair:after{width:18px;height:2px;left:0;top:8px}
#top{position:absolute;left:16px;top:14px;font-weight:bold;font-size:14px}
#status{position:absolute;left:50%;top:calc(50% + 25px);transform:translateX(-50%);font-weight:bold;font-size:13px;opacity:.95}
#hotbar{position:absolute;left:50%;bottom:18px;transform:translateX(-50%);display:flex;padding:4px;background:rgba(0,0,0,.45);border:2px solid #222}
.slot{width:54px;height:54px;border:2px solid #777;background:rgba(30,30,30,.75);position:relative;display:flex;align-items:center;justify-content:center}
.slot.selected{border:3px solid white;box-shadow:0 0 0 2px #555 inset}
.slot canvas{width:38px;height:38px;image-rendering:pixelated}
.slot span{position:absolute;right:3px;bottom:1px;font-size:12px}
#bars{position:absolute;left:50%;bottom:82px;transform:translateX(-50%);display:flex;gap:5px;font-size:20px;letter-spacing:1px}
#bars .heart{color:#e51c23}
#bars .food{color:#d18a3a}
#inventoryHint{position:absolute;right:15px;top:15px;text-align:right;font-size:12px;line-height:1.5}
#menu{position:fixed;inset:0;background:rgba(0,0,0,.72);display:flex;align-items:center;justify-content:center;z-index:30;color:#fff}
.panel{width:min(520px,92vw);padding:28px;background:rgba(18,18,18,.94);border:3px solid #777;box-shadow:0 8px 30px #000;text-align:center}
.panel h1{margin:0 0 10px;font-size:30px}
.panel p{line-height:1.5;color:#ddd}
button{font:inherit;font-weight:bold;padding:12px 22px;border:2px solid #555;background:#8a8a8a;color:#fff;cursor:pointer}
button:hover{background:#aaa}
#breakBar{position:absolute;left:50%;top:calc(50% + 45px);transform:translateX(-50%);width:130px;height:9px;border:2px solid #222;background:#777;display:none}
#breakFill{height:100%;width:0;background:#ddd}
#toast{position:absolute;left:50%;bottom:150px;transform:translateX(-50%);font-weight:bold;background:rgba(0,0,0,.55);padding:7px 12px;display:none}
</style>

</head>

<body>
<div id="hud">
  <div id="top">BIG MOE STUDYING • SURVIVAL</div>
  <div id="inventoryHint">WASD move • SPACE jump • SHIFT sprint<br>Left click mine • Right click place<br>1–9 select • Wheel change block • ESC pause</div>
  <div id="crosshair"></div>
  <div id="status"></div>
  <div id="breakBar"><div id="breakFill"></div></div>
  <div id="bars"><span id="hearts" class="heart">♥♥♥♥♥♥♥♥♥♥</span>&nbsp;&nbsp;<span id="food" class="food">🍗🍗🍗🍗🍗🍗🍗🍗🍗🍗</span></div>
  <div id="hotbar"></div>
  <div id="toast"></div>
  <div id="touch">
    <div id="joystick" class="joy"><div id="stick"></div></div>
    <button id="jump" class="touchBtn" type="button">↑</button>
    <button id="mine" class="touchBtn" type="button">⛏</button>
    <button id="place" class="touchBtn" type="button">＋</button>
    <button id="sprint" class="touchBtn" type="button">RUN</button>
    <div id="slotsTouch"></div>
  </div>
</div>

<div id="menu">
  <div class="panel">
    <h1>Big Moe Studying</h1>
    <p><b>Minecraft-style Survival World</b></p>
    <p>This version uses an original implementation and original generated pixel textures. It is designed to feel much closer to the classic Minecraft first-person experience.</p>
    <button id="start">CLICK TO PLAY</button>
  </div>
</div>


<script type="module">
import * as THREE from "https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js";

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x78b8e8);
scene.fog = new THREE.Fog(0x78b8e8, 38, 105);

const camera = new THREE.PerspectiveCamera(75, innerWidth/innerHeight, .05, 180);
camera.rotation.order = "YXZ";

const renderer = new THREE.WebGLRenderer({antialias:false});
renderer.setSize(innerWidth,innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio,1.5));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
document.body.prepend(renderer.domElement);

const hemi = new THREE.HemisphereLight(0xbfe8ff,0x66513b,1.25);
scene.add(hemi);
const sun = new THREE.DirectionalLight(0xffffff,1.8);
sun.position.set(-35,70,25);
sun.castShadow=true;
sun.shadow.mapSize.set(2048,2048);
sun.shadow.camera.left=-65; sun.shadow.camera.right=65;
sun.shadow.camera.top=65; sun.shadow.camera.bottom=-65;
scene.add(sun);

const world = new THREE.Group();
scene.add(world);

const defs = [
  ["grass","Grass Block",0x67b53c],
  ["dirt","Dirt",0x8a542f],
  ["stone","Stone",0x858585],
  ["cobble","Cobblestone",0x6e6e6e],
  ["oaklog","Oak Log",0x79502d],
  ["oakplanks","Oak Planks",0xb5824b],
  ["leaves","Oak Leaves",0x438b38],
  ["sand","Sand",0xd9c16d],
  ["gravel","Gravel",0x8c8a83],
  ["coal","Coal Ore",0x555555],
  ["iron","Iron Ore",0x8c8a83],
  ["gold","Gold Ore",0x8c8a83],
  ["diamond","Diamond Ore",0x8c8a83],
  ["bedrock","Bedrock",0x303030],
  ["bricks","Bricks",0xa34c3d],
  ["glass","Glass",0xb7e8ed],
  ["wool","White Wool",0xe7e7e7]
];
const TYPES=Object.fromEntries(defs.map(([id,name,color])=>[id,{id,name,color}]));
const hotbar=["grass","dirt","stone","cobble","oaklog","oakplanks","sand","gravel","wool"];
let selected=0;

function tex(color, pattern="noise"){
  const c=document.createElement("canvas"); c.width=c.height=16;
  const x=c.getContext("2d"); x.fillStyle="#"+color.toString(16).padStart(6,"0"); x.fillRect(0,0,16,16);
  for(let y=0;y<16;y++)for(let z=0;z<16;z++){
    let n=((xorshift((y+1)*97+(z+1)*193))%24)-12;
    if(pattern==="bricks" && y%4===0)n=-35;
    if(pattern==="ore" && Math.random()<.075)n=70;
    x.fillStyle=`rgb(${Math.max(0,Math.min(255,((color>>16)&255)+n))},${Math.max(0,Math.min(255,((color>>8)&255)+n))},${Math.max(0,Math.min(255,(color&255)+n))})`;
    x.fillRect(z,y,1,1);
  }
  x.imageSmoothingEnabled=false;
  const t=new THREE.CanvasTexture(c); t.magFilter=THREE.NearestFilter; t.minFilter=THREE.NearestFilter;
  return t;
}
function xorshift(n){n|=0;n^=n<<13;n^=n>>>17;n^=n<<5;return Math.abs(n)|0}

const mats={};
for(const [id,d] of Object.entries(TYPES)){
  const base=d.color;
  let p="noise";
  if(id==="bricks")p="bricks";
  if(id.endsWith("ore"))p="ore";
  const t=tex(base,p);
  mats[id]=new THREE.MeshLambertMaterial({map:t,transparent:id==="glass",opacity:id==="glass"?.55:1});
}

const blocks=new Map();
const key=(x,y,z)=>`${x},${y},${z}`;
function setBlock(x,y,z,type){
  if(y<0)return;
  const k=key(x,y,z);
  if(type===null){blocks.delete(k); return;}
  blocks.set(k,type);
}
function getBlock(x,y,z){return blocks.get(key(x,y,z))||null}

const W=82, D=82;
function terrainHeight(x,z){
  const a=Math.sin(x*.11)*2.5+Math.cos(z*.12)*2.2+Math.sin((x+z)*.045)*4;
  const b=Math.sin(x*.035-z*.06)*3;
  return Math.max(3,Math.floor(8+a+b));
}
function noise2(x,z){return Math.abs(Math.sin(x*12.9898+z*78.233)*43758.5453)%1}

for(let x=-W/2;x<W/2;x++)for(let z=-D/2;z<D/2;z++){
  const h=terrainHeight(x,z);
  for(let y=0;y<=h;y++){
    let type=y===0?"bedrock":y<h-3?"stone":y<h?"dirt":"grass";
    if(y===h && noise2(x,z)<.035)type="sand";
    setBlock(x,y,z,type);
  }
  if(h<5 && noise2(x+5,z-2)<.12){
    for(let y=0;y<3;y++)setBlock(x,h+1+y,z,"oaklog");
    for(let dx=-2;dx<=2;dx++)for(let dz=-2;dz<=2;dz++){
      if(Math.abs(dx)+Math.abs(dz)<4)setBlock(x+dx,h+4,z+dz,"leaves");
    }
    setBlock(x,h+5,z,"leaves");
  }
}

function addMesh(x,y,z,type){
  const g=new THREE.BoxGeometry(1,1,1);
  const m=new THREE.Mesh(g,mats[type]||mats.stone);
  m.position.set(x+.5,y+.5,z+.5);
  m.castShadow=type!=="glass"; m.receiveShadow=true;
  m.userData={x,y,z,type};
  world.add(m);
  return m;
}
function rebuild(){
  while(world.children.length)world.remove(world.children[0]);
  for(const [k,t] of blocks){
    const [x,y,z]=k.split(",").map(Number);
    addMesh(x,y,z,t);
  }
}
rebuild();

const player={
  pos:new THREE.Vector3(0,terrainHeight(0,0)+2.05,0),
  vel:new THREE.Vector3(),
  yaw:0,pitch:0,
  onGround:false,
  health:20,hunger:20
};
camera.position.copy(player.pos);

const keys={};
let touchLook=false,lastTX=0,lastTY=0;
let touchMoveX=0,touchMoveY=0,touchSprint=false;
const touch=document.getElementById("touch");
addEventListener("keydown",e=>{
  keys[e.code]=true;
  if(/^Digit[1-9]$/.test(e.code)){selected=Number(e.code.slice(-1))-1;updateHotbar()}
  if(e.code==="KeyE")document.getElementById("menu").style.display="flex";
});
addEventListener("keyup",e=>keys[e.code]=false);

const menu=document.getElementById("menu");
document.getElementById("start").onclick=()=>{menu.style.display="none";renderer.domElement.requestPointerLock()};
renderer.domElement.addEventListener("click",()=>{if(menu.style.display==="none")renderer.domElement.requestPointerLock()});

document.addEventListener("mousemove",e=>{
  if(document.pointerLockElement!==renderer.domElement)return;
  player.yaw-=e.movementX*.0022;
  player.pitch-=e.movementY*.0022;
  player.pitch=Math.max(-Math.PI/2+.02,Math.min(Math.PI/2-.02,player.pitch));
});

const raycaster=new THREE.Raycaster();
raycaster.far=5.2;
let target=null, breakTarget=null, breakStart=0;

function updateTarget(){
  raycaster.setFromCamera(new THREE.Vector2(0,0),camera);
  const hits=raycaster.intersectObjects(world.children,false);
  target=hits[0]||null;
  if(target){
    const b=target.object.userData;
    highlight.position.copy(target.object.position);
    highlight.visible=true;
    status.textContent=TYPES[b.type]?.name||b.type;
  }else{
    highlight.visible=false;
    status.textContent="";
  }
}
const highlight=new THREE.Mesh(
  new THREE.BoxGeometry(1.015,1.015,1.015),
  new THREE.MeshBasicMaterial({color:0xffffff,wireframe:true,transparent:true,opacity:.75})
);
scene.add(highlight);
const status=document.getElementById("status");

function tryMine(){
  if(!target)return;
  const b=target.object.userData;
  if(b.y<=0)return;
  breakTarget=target.object;
  breakStart=performance.now();
}
function finishMine(){
  if(!breakTarget)return;
  const b=breakTarget.userData;
  setBlock(b.x,b.y,b.z,null);
  world.remove(breakTarget);
  breakTarget=null;
  document.getElementById("breakBar").style.display="none";
}
function place(){
  if(!target)return;
  const b=target.object.userData;
  const n=target.face.normal;
  const x=b.x+Math.round(n.x),y=b.y+Math.round(n.y),z=b.z+Math.round(n.z);
  if(y<1||getBlock(x,y,z))return;
  const px=Math.floor(player.pos.x),py=Math.floor(player.pos.y),pz=Math.floor(player.pos.z);
  if(x===px&&z===pz&&y>=py-1&&y<=py+1)return;
  const type=hotbar[selected];
  setBlock(x,y,z,type);
  addMesh(x,y,z,type);
}
addEventListener("mousedown",e=>{
  if(document.pointerLockElement!==renderer.domElement)return;
  if(e.button===0)tryMine();
  if(e.button===2)place();
});

function bindHold(el,down,up){
  el.addEventListener("pointerdown",e=>{e.preventDefault();el.setPointerCapture?.(e.pointerId);down()});
  el.addEventListener("pointerup",e=>{e.preventDefault();up?.()});
  el.addEventListener("pointercancel",()=>up?.());
}
const joy=document.getElementById("joystick"),stick=document.getElementById("stick");
joy.addEventListener("pointerdown",e=>{touchLook=false;joy.setPointerCapture(e.pointerId);touchMoveX=touchMoveY=0;});
joy.addEventListener("pointermove",e=>{if(!joy.hasPointerCapture(e.pointerId))return;const r=joy.getBoundingClientRect(),cx=r.left+r.width/2,cy=r.top+r.height/2;let dx=e.clientX-cx,dy=e.clientY-cy;const max=45,len=Math.hypot(dx,dy);if(len>max){dx*=max/len;dy*=max/len}stick.style.transform=`translate(${dx}px,${dy}px)`;touchMoveX=dx/max;touchMoveY=dy/max;});
joy.addEventListener("pointerup",e=>{stick.style.transform="";touchMoveX=touchMoveY=0});

const jumpBtn=document.getElementById("jump"),mineBtn=document.getElementById("mine"),placeBtn=document.getElementById("place"),sprintBtn=document.getElementById("sprint");
bindHold(jumpBtn,()=>keys.Space=true,()=>keys.Space=false);
bindHold(mineBtn,()=>tryMine());
bindHold(placeBtn,()=>place());
bindHold(sprintBtn,()=>touchSprint=true,()=>touchSprint=false);

let lookId=null;
touch.addEventListener("pointerdown",e=>{if(e.target!==touch)return;lookId=e.pointerId;lastTX=e.clientX;lastTY=e.clientY;touch.setPointerCapture(e.pointerId)});
touch.addEventListener("pointermove",e=>{if(e.pointerId!==lookId)return;const dx=e.clientX-lastTX,dy=e.clientY-lastTY;lastTX=e.clientX;lastTY=e.clientY;player.yaw-=dx*.009;player.pitch-=dy*.009;player.pitch=Math.max(-Math.PI/2+.02,Math.min(Math.PI/2-.02,player.pitch));});
touch.addEventListener("pointerup",e=>{if(e.pointerId===lookId)lookId=null});

addEventListener("contextmenu",e=>e.preventDefault());

addEventListener("wheel",e=>{
  selected=(selected+(e.deltaY>0?1:-1)+hotbar.length)%hotbar.length;
  updateHotbar();
},{passive:true});

function updateHotbar(){
  const bar=document.getElementById("hotbar");bar.innerHTML="";
  hotbar.forEach((id,i)=>{
    const s=document.createElement("div");s.className="slot"+(i===selected?" selected":"");
    const c=document.createElement("canvas");c.width=c.height=16;c.style.imageRendering="pixelated";
    const ctx=c.getContext("2d");
    const color=TYPES[id].color;
    ctx.fillStyle="#"+color.toString(16).padStart(6,"0");ctx.fillRect(0,0,16,16);
    for(let n=0;n<30;n++){ctx.fillStyle="rgba(255,255,255,.08)";ctx.fillRect((n*7)%16,(n*11)%16,1,1)}
    s.appendChild(c);const num=document.createElement("span");num.textContent=i+1;s.appendChild(num);bar.appendChild(s);
  });
  const ts=document.getElementById("slotsTouch");
  if(ts){ts.innerHTML="";hotbar.forEach((id,i)=>{const b=document.createElement("button");b.type="button";b.textContent=i+1;b.className=i===selected?"selected":"";b.addEventListener("pointerdown",e=>{e.preventDefault();selected=i;updateHotbar()});ts.appendChild(b)})}
}
updateHotbar();

const aabb={w:.6,h:1.8,d:.6};
function solidAt(x,y,z){return !!getBlock(x,y,z)}
function collides(pos){
  const minX=Math.floor(pos.x-aabb.w/2),maxX=Math.floor(pos.x+aabb.w/2);
  const minY=Math.floor(pos.y),maxY=Math.floor(pos.y+aabb.h);
  const minZ=Math.floor(pos.z-aabb.d/2),maxZ=Math.floor(pos.z+aabb.d/2);
  for(let x=minX;x<=maxX;x++)for(let y=minY;y<=maxY;y++)for(let z=minZ;z<=maxZ;z++)if(solidAt(x,y,z))return true;
  return false;
}
function moveAxis(axis,amount){
  if(!amount)return;
  player.pos[axis]+=amount;
  if(collides(player.pos)){
    player.pos[axis]-=amount;
    if(axis==="y"){
      if(amount<0)player.onGround=true;
      player.vel.y=0;
    }
  }
}

let last=performance.now();
function animate(now){
  requestAnimationFrame(animate);
  let dt=Math.min(.05,(now-last)/1000);last=now;

  if(document.pointerLockElement===renderer.domElement){
    const speed=((keys.ShiftLeft||keys.ShiftRight)||touchSprint)?7.5:4.7;
    const f=new THREE.Vector3(Math.sin(player.yaw),0,Math.cos(player.yaw));
    const r=new THREE.Vector3(Math.cos(player.yaw),0,-Math.sin(player.yaw));
    const wish=new THREE.Vector3();
    if(keys.KeyW||touchMoveY<-.15)wish.add(f);
    if(keys.KeyS||touchMoveY>.15)wish.sub(f);
    if(keys.KeyD||touchMoveX>.15)wish.add(r);
    if(keys.KeyA||touchMoveX<-.15)wish.sub(r);
    if(wish.lengthSq())wish.normalize().multiplyScalar(speed);
    player.vel.x+=(wish.x-player.vel.x)*Math.min(1,dt*12);
    player.vel.z+=(wish.z-player.vel.z)*Math.min(1,dt*12);
    if((keys.Space)&&player.onGround){player.vel.y=8.3;player.onGround=false}
    player.vel.y-=22*dt;
    player.onGround=false;
    moveAxis("x",player.vel.x*dt);
    moveAxis("z",player.vel.z*dt);
    moveAxis("y",player.vel.y*dt);

    if(player.pos.y<-10){
      player.pos.set(0,terrainHeight(0,0)+3,0);player.vel.set(0,0,0);player.health=20;
    }
    player.hunger=Math.max(0,player.hunger-dt*.002);
    camera.position.set(player.pos.x,player.pos.y+1.62,player.pos.z);
    camera.rotation.set(player.pitch,player.yaw,0);
    updateTarget();
  }

  if(breakTarget){
    const fill=Math.min(1,(now-breakStart)/650);
    document.getElementById("breakBar").style.display="block";
    document.getElementById("breakFill").style.width=(fill*100)+"%";
    if(fill>=1)finishMine();
  }
  document.getElementById("hearts").textContent="♥".repeat(Math.ceil(player.health/2))+"♡".repeat(10-Math.ceil(player.health/2));
  document.getElementById("food").textContent="🍗".repeat(Math.ceil(player.hunger/2))+"·".repeat(10-Math.ceil(player.hunger/2));
  renderer.render(scene,camera);
}
requestAnimationFrame(animate);

addEventListener("resize",()=>{
  camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();
  renderer.setSize(innerWidth,innerHeight);
});
</script>

</body>
</html>
