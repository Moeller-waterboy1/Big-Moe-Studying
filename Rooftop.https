<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,user-scalable=no">
<title>Big Moe Rooftop Duel</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#8fd0f2;font-family:Arial,sans-serif}
body{touch-action:none}
canvas{display:block;width:100%;height:100%}
#menu,#pause{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,20,45,.72);z-index:10;color:#fff;text-align:center}
.card{width:min(520px,92vw);background:#06264b;border:4px solid #ffd43b;border-radius:18px;padding:28px;box-shadow:0 15px 50px #001}
h1{margin:0 0 8px;color:#ffd43b;font-size:clamp(32px,7vw,58px)}
p{line-height:1.5}
button{border:0;border-radius:12px;background:#ffd43b;color:#06264b;font-weight:900;padding:14px 22px;font-size:18px;cursor:pointer}
#hud{position:fixed;left:0;right:0;top:0;padding:14px;z-index:4;pointer-events:none;color:#fff;text-shadow:2px 2px 3px #000;font-weight:900}
.score{display:flex;justify-content:space-between;font-size:20px}
.bar{height:16px;background:#222;border:2px solid #fff;border-radius:8px;overflow:hidden;margin-top:5px;width:min(34vw,280px)}
.fill{height:100%;width:100%}
#p1bar{background:#35a7ff} #p2bar{background:#ff5268}
#hint{position:fixed;top:75px;left:50%;transform:translateX(-50%);color:#fff;text-shadow:2px 2px #000;font-weight:bold;z-index:4}
#controls{position:fixed;left:0;right:0;bottom:18px;z-index:5;display:flex;justify-content:space-between;padding:0 18px;pointer-events:none}
.pad{display:flex;gap:10px;pointer-events:auto}
.ctrl{width:64px;height:64px;border:3px solid #fff;border-radius:50%;background:rgba(0,25,55,.65);color:#fff;font-size:25px;font-weight:900}
.fire{background:rgba(220,50,50,.75)}
#win{display:none;position:fixed;inset:0;z-index:9;align-items:center;justify-content:center;background:rgba(0,0,0,.6);color:#fff;text-align:center}
</style>
</head>
<body>
<canvas id="game"></canvas>

<div id="hud">
  <div class="score">
    <div>BLUE <div class="bar"><div id="p1bar" class="fill"></div></div></div>
    <div style="text-align:right">RED <div class="bar"><div id="p2bar" class="fill"></div></div></div>
  </div>
</div>
<div id="hint">A/D or ◀/▶ to move • W / ▲ to jump • SPACE / 🔥 to fire</div>

<div id="controls">
  <div class="pad">
    <button class="ctrl" data-key="a">◀</button>
    <button class="ctrl" data-key="d">▶</button>
    <button class="ctrl" data-key="w">▲</button>
  </div>
  <div class="pad">
    <button class="ctrl fire" data-key="fire">🔥</button>
  </div>
</div>

<div id="menu">
 <div class="card">
   <h1>ROOFTOP DUEL</h1>
   <p><b>Big Moe Studying Edition</b></p>
   <p>A fast two-player rooftop battle. Knock your opponent off the buildings or blast them with your launcher.</p>
   <p><b>Player 1:</b> A/D + W + Space<br><b>Player 2:</b> Arrow Keys + Up + Enter</p>
   <button id="start">START GAME</button>
 </div>
</div>

<div id="win">
 <div class="card">
   <h1 id="winner">BLUE WINS!</h1>
   <p id="reason"></p>
   <button id="again">PLAY AGAIN</button>
 </div>
</div>

<script>
const c=document.getElementById("game"),ctx=c.getContext("2d");
let W,H,scale=1,last=0,gameOver=false;
const keys={};
const gravity=.58;

function resize(){W=c.width=innerWidth*devicePixelRatio;H=c.height=innerHeight*devicePixelRatio;ctx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0);W=innerWidth;H=innerHeight}
addEventListener("resize",resize);resize();

const buildings=[
 {x:.05,w:.29,h:.42},
 {x:.66,w:.29,h:.52}
];

let platforms=[];
let players=[],bullets=[],particles=[],screenShake=0;

function setup(){
 platforms=buildings.map(b=>({x:b.x*W,y:H-b.h*H,w:b.w*W,h:b.h*H}));
 players=[
  {x:platforms[0].x+platforms[0].w*.58,y:platforms[0].y-54,vx:0,vy:0,w:30,h:54,hp:100,color:"#35a7ff",facing:1,ground:false,fire:0},
  {x:platforms[1].x+platforms[1].w*.42,y:platforms[1].y-54,vx:0,vy:0,w:30,h:54,hp:100,color:"#ff5268",facing:-1,ground:false,fire:0}
 ];
 bullets=[];particles=[];gameOver=false;
 document.getElementById("win").style.display="none";
}
setup();

function down(k){return !!keys[k]}
addEventListener("keydown",e=>{
 keys[e.key.toLowerCase()]=true;
 if([" ","arrowup","arrowdown","arrowleft","arrowright"].includes(e.key.toLowerCase()))e.preventDefault();
});
addEventListener("keyup",e=>keys[e.key.toLowerCase()]=false);

document.querySelectorAll(".ctrl").forEach(b=>{
 const k=b.dataset.key;
 const on=e=>{e.preventDefault();keys[k]=true};
 const off=e=>{e.preventDefault();keys[k]=false};
 b.addEventListener("pointerdown",on);
 b.addEventListener("pointerup",off);
 b.addEventListener("pointercancel",off);
 b.addEventListener("pointerleave",off);
});

document.getElementById("start").onclick=()=>{setup();document.getElementById("menu").style.display="none"};
document.getElementById("again").onclick=setup;

function rectHit(a,b){
 return a.x<a.x+a.w && a.x+a.w>b.x && a.y<a.y+a.h && a.y+a.h>b.y;
}
function particle(x,y,color){
 for(let i=0;i<8;i++)particles.push({x,y,vx:(Math.random()-.5)*5,vy:(Math.random()-.8)*5,life:25+Math.random()*20,color});
}
function fire(p){
 if(p.fire>0)return;
 p.fire=28;
 const speed=10*p.facing;
 bullets.push({
  x:p.x+p.w/2+p.facing*20,y:p.y+20,vx:speed,vy:-1.8,
  owner:p,color:p.color,r:7
 });
 particle(p.x+p.w/2+p.facing*22,p.y+20,"#ffd43b");
}
function controls(){
 const p1=players[0],p2=players[1];
 if(down("a")){p1.vx-=.45;p1.facing=-1}
 if(down("d")){p1.vx+=.45;p1.facing=1}
 if((down("w")||down("arrowup"))&&p1.ground){p1.vy=-11;p1.ground=false}
 if(down(" "))fire(p1);

 if(down("arrowleft")){p2.vx-=.45;p2.facing=-1}
 if(down("arrowright")){p2.vx+=.45;p2.facing=1}
 if(down("arrowup")&&p2.ground){p2.vy=-11;p2.ground=false}
 if(down("enter"))fire(p2);
}
function updatePlayer(p){
 p.fire=Math.max(0,p.fire-1);
 p.vx*=.86;
 p.vy+=gravity;
 p.x+=p.vx;p.y+=p.vy;
 p.ground=false;

 for(const q of platforms){
  if(p.x+p.w>q.x && p.x<q.x+q.w && p.y+p.h>=q.y && p.y+p.h<=q.y+22 && p.vy>=0){
   p.y=q.y-p.h;p.vy=0;p.ground=true;
  }
 }
 if(p.x<0){p.x=0;p.vx=0}
 if(p.x+p.w>W){p.x=W-p.w;p.vx=0}
}
function updateBullets(){
 for(const b of bullets){
  b.vy+=.11;b.x+=b.vx;b.y+=b.vy;
  for(const q of platforms){
   if(b.x>q.x&&b.x<q.x+q.w&&b.y>q.y&&b.y<q.y+q.h){
    particle(b.x,b.y,"#ffd43b");b.dead=true;screenShake=5;
   }
  }
  for(const p of players){
   if(p!==b.owner && b.x>p.x-4&&b.x<p.x+p.w+4&&b.y>p.y&&b.y<p.y+p.h){
    p.hp=Math.max(0,p.hp-22);
    p.vx+=b.vx*.35;p.vy=-3;
    particle(b.x,b.y,p.color);b.dead=true;screenShake=8;
   }
  }
  if(b.x<-30||b.x>W+30||b.y>H+50)b.dead=true;
 }
 bullets=bullets.filter(b=>!b.dead);
}
function updateParticles(){
 for(const p of particles){p.x+=p.vx;p.y+=p.vy;p.vy+=.12;p.life--}
 particles=particles.filter(p=>p.life>0);
}
function checkWin(){
 for(let i=0;i<2;i++){
  const p=players[i];
  if(p.hp<=0 || p.y>H+100){
   gameOver=true;
   const winner=i===0?"RED WINS!":"BLUE WINS!";
   document.getElementById("winner").textContent=winner;
   document.getElementById("reason").textContent=p.hp<=0?"Your opponent knocked out your health!":"Your opponent knocked you off the rooftops!";
   document.getElementById("win").style.display="flex";
  }
 }
}
function drawSky(){
 const g=ctx.createLinearGradient(0,0,0,H);g.addColorStop(0,"#69b8ed");g.addColorStop(1,"#d9f1ff");
 ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
 ctx.fillStyle="rgba(255,255,255,.65)";
 for(let i=0;i<7;i++){let x=(i*181+80)%W,y=70+(i%3)*65;ctx.beginPath();ctx.arc(x,y,22,0,7);ctx.arc(x+24,y+4,28,0,7);ctx.arc(x+52,y,18,0,7);ctx.fill()}
}
function drawBuilding(q){
 ctx.fillStyle="#333b4b";ctx.fillRect(q.x,q.y,q.w,q.h);
 ctx.fillStyle="#242a37";ctx.fillRect(q.x,q.y,q.w,10);
 for(let y=q.y+30;y<H;y+=44)for(let x=q.x+18;x<q.x+q.w-12;x+=38){
  ctx.fillStyle=(Math.floor(x/38)+Math.floor(y/44))%2?"#6d7d8e":"#506070";
  ctx.fillRect(x,y,20,25);
 }
 ctx.fillStyle="#ffd43b";ctx.fillRect(q.x,q.y,q.w,5);
}
function drawPlayer(p){
 ctx.save();ctx.translate(p.x+p.w/2,p.y+p.h/2);
 ctx.scale(p.facing,1);
 ctx.fillStyle=p.color;ctx.fillRect(-p.w/2,-p.h/2,p.w,p.h);
 ctx.fillStyle="#222";ctx.fillRect(-12,-29,24,18);
 ctx.fillStyle="#eee";ctx.fillRect(2,-25,7,7);
 ctx.fillStyle="#222";ctx.fillRect(-10,0,7,22);ctx.fillRect(3,0,7,22);
 ctx.fillStyle="#ffd43b";ctx.fillRect(5,-4,25,6);
 ctx.restore();
}
function draw(){
 ctx.save();
 if(screenShake>0){ctx.translate((Math.random()-.5)*screenShake,(Math.random()-.5)*screenShake);screenShake*=.82}
 drawSky();
 platforms.forEach(drawBuilding);
 bullets.forEach(b=>{ctx.fillStyle=b.color;ctx.beginPath();ctx.arc(b.x,b.y,b.r,0,7);ctx.fill()});
 particles.forEach(p=>{ctx.globalAlpha=Math.max(0,p.life/40);ctx.fillStyle=p.color;ctx.fillRect(p.x,p.y,4,4);ctx.globalAlpha=1});
 players.forEach(drawPlayer);
 ctx.restore();
 document.getElementById("p1bar").style.width=players[0].hp+"%";
 document.getElementById("p2bar").style.width=players[1].hp+"%";
}
function loop(t){
 const dt=Math.min(33,t-last);last=t;
 if(!gameOver && document.getElementById("menu").style.display==="none"){
  controls();players.forEach(updatePlayer);updateBullets();updateParticles();checkWin();
 }
 draw();requestAnimationFrame(loop);
}
requestAnimationFrame(loop);
</script>
</body>
</html>
